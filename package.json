{
  "name": "dsh-codebuddy-auth",
  "version": "0.9.0",
  "description": "CodeBuddy (Tencent IOA) as a native DeepSeek Harness llm provider: browser OAuth login, token auto-renewal, credential storage, and /v3/config model sync.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "codebuddy-login": "./bin/login-flow.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "login": "node bin/login-flow.mjs",
    "test": "node --import ./test/resolve-harness.mjs --test test/*.test.mjs",
    "test:coverage": "node --import ./test/resolve-harness.mjs --test --experimental-test-coverage test/*.test.mjs"
  },
  "engines": {
    "node": ">=18.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "codebuddy",
    "tencent",
    "oauth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cainiao1992/dsh-codebuddy-auth.git"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.1"
  }
}
